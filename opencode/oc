#!/usr/bin/env bash
#
# Launch OpenCode inside a simple bubble-wrap sandbox.
# Inspiration: https://github.com/didvc/opencode-bwrap

set -euo pipefail

# Traverse and obtain true script directory
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
# Canonicalize path and prevent running directly inside $HOME
PROJECT_DIR="$(realpath "${1:-$PWD}")"
if [[ "$PROJECT_DIR" == "$HOME" ]]; then
  echo "Error: Refusing to run in \$HOME directly to prevent exposing full home directory." >&2
  exit 1
fi

BWRAP_ARGS=()
# Namespace isolation
BWRAP_ARGS+=(--unshare-all)
BWRAP_ARGS+=(--share-net)
BWRAP_ARGS+=(--die-with-parent)
BWRAP_ARGS+=(--new-session)
BWRAP_ARGS+=(--cap-drop ALL)
# Runtime plumbing
BWRAP_ARGS+=(--proc /proc)
BWRAP_ARGS+=(--dev /dev)
BWRAP_ARGS+=(--tmpfs /tmp)
BWRAP_ARGS+=(--tmpfs /run)
BWRAP_ARGS+=(--ro-bind-try /run/systemd/resolve /run/systemd/resolve)
# Base OS
BWRAP_ARGS+=(--ro-bind /usr /usr)
BWRAP_ARGS+=(--symlink usr/lib /lib)
BWRAP_ARGS+=(--symlink usr/lib64 /lib64)
BWRAP_ARGS+=(--symlink usr/bin /bin)
BWRAP_ARGS+=(--symlink usr/sbin /sbin)
BWRAP_ARGS+=(--ro-bind /etc /etc) # Note: Shadow requires root and is not visible
# Home and environment
BWRAP_ARGS+=(--clearenv)
BWRAP_ARGS+=(--setenv PATH "$PATH")
BWRAP_ARGS+=(--setenv TERM "${TERM:-xterm-256color}")
BWRAP_ARGS+=(--setenv LANG "C.UTF-8")
BWRAP_ARGS+=(--setenv HOME "$HOME")
BWRAP_ARGS+=(--setenv USER "$(id -un)")
BWRAP_ARGS+=(--setenv LOGNAME "$(id -un)")
BWRAP_ARGS+=(--setenv TMPDIR /tmp)
BWRAP_ARGS+=(--setenv XDG_CACHE_HOME "$HOME/.cache")
BWRAP_ARGS+=(--setenv HISTFILE /dev/null)
BWRAP_ARGS+=(--dir "$HOME")
BWRAP_ARGS+=(--chdir "$PROJECT_DIR")
# OpenCode state
OP_CONFIG="$HOME/.config/opencode"
OP_DATA="$HOME/.local/share/opencode"
OP_CACHE="$HOME/.cache/opencode"
OP_STATE="$HOME/.local/state/opencode"
mkdir -p "$OP_CONFIG" "$OP_DATA" "$OP_CACHE" "$OP_STATE"
BWRAP_ARGS+=(--ro-bind "$HOME/.opencode/bin" "$HOME/.opencode/bin")
BWRAP_ARGS+=(--ro-bind "$OP_CONFIG" "$OP_CONFIG")
BWRAP_ARGS+=(--ro-bind "$SCRIPT_DIR/opencode.jsonc" "$OP_CONFIG/opencode.jsonc") # Map local config
BWRAP_ARGS+=(--bind "$OP_DATA" "$OP_DATA")
BWRAP_ARGS+=(--bind "$OP_CACHE" "$OP_CACHE")
BWRAP_ARGS+=(--bind "$OP_STATE" "$OP_STATE")
BWRAP_ARGS+=(--setenv OPENCODE_ENABLE_EXA 1) # Enable websearch
# Project, with .git write-blocked
BWRAP_ARGS+=(--bind "$PROJECT_DIR" "$PROJECT_DIR")
BWRAP_ARGS+=(--ro-bind-try "$PROJECT_DIR/.git" "$PROJECT_DIR/.git")

exec bwrap "${BWRAP_ARGS[@]}" -- opencode "$@"
