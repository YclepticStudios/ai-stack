{
  "$schema": "https://opencode.ai/config.json",
  "model": "basalt/qwen3.8-flash-next",
  "share": "disabled",
  "providers": {
    "basalt": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:9931/v1",
      },
      "models": {
        "qwen3.8-flash-next": {
          "limit": {
            "context": 262144,
            "output": 64000,
          },
          "capabilities": {
            "reasoning": {
              "supported": true,
              "toggle": true,
              "effort": ["low", "medium", "high"],
            },
          },
        },
        "qwen3.8-27b": {
          "limit": {
            "context": 250000,
            "output": 64000,
          },
          "capabilities": {
            "reasoning": {
              "supported": true,
              "toggle": true,
              "effort": ["low", "medium", "high"],
            },
          },
        },
        "deepseek-v4.1-flash": {
          "limit": {
            "context": 262144,
            "output": 64000,
          },
          "capabilities": {
            "reasoning": {
              "supported": true,
              "toggle": true,
              "effort": ["low", "medium", "high"],
            },
          },
        },
      },
    },
  },
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "basalt", "effect": "allow" },
  ],
}
