{
  "network": {
    "allowLocalBinding": true,
    "allowAllUnixSockets": true,
    "allowedDomains": [
      "npmjs.org",
      "*.npmjs.org",
      "registry.npmjs.org",
      "registry.yarnpkg.com",
      "pypi.org",
      "*.pypi.org",
      "github.com",
      "*.github.com",
      "api.github.com",
      "raw.githubusercontent.com"
    ]
  },
  "filesystem": {
    "denyRead": ["/home", "/run/user", "/run/systemd", "/var/run/docker.sock"],
    "allowRead": [".", "~/.config", "~/.local"],
    "allowWrite": [".", "/tmp"],
    "denyWrite": [".git", ".env", ".env.*", "*.pem", "*.key"]
  }
}
